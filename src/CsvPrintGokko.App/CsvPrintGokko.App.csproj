<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CsvPrintGokko.Core\CsvPrintGokko.Core.csproj" />
  </ItemGroup>

  <!--
    UIをWebView2(Chromiumベースの組み込みブラウザコントロール)でホストするための参照。
    ランタイムはOS標準搭載のEvergreen版に依存し、配布物には同梱しない。
    バージョンはCLAUDE.mdの依存関係更新ポリシーに従い、公開から十分な期間が経過した安定版を明示的に固定する。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!-- 初めて使う人向けのサンプル(CSV+単票PDF)。ビルド・発行の都度、exeと同じフォルダにコピーする。 -->
  <ItemGroup>
    <None Include="samples\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 配布用の操作マニュアル(docs/操作マニュアル.mdをPDF化したもの)。exeと同じフォルダにコピーする。 -->
  <ItemGroup>
    <None Include="manual\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 保存先フォルダ選択ダイアログ(FolderBrowserDialog)のためWindows Formsを有効化 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- ダブルクリック起動時にコンソールウィンドウを表示しない -->
    <OutputType>WinExe</OutputType>
    <!-- 単一ユーザー向けのローカルツールのため、多コア向けのServer GCではなくメモリ効率重視のWorkstation GCを使う -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- exeのファイル情報(プロパティ)・アイコンに表示されるアプリ名 -->
    <Product>CSVペタっとPDF</Product>
    <AssemblyTitle>CSVペタっとPDF</AssemblyTitle>
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
    <!-- 出力されるexeのファイル名(プロジェクト名/名前空間自体は変更しない) -->
    <AssemblyName>csvpetattopdf</AssemblyName>
  </PropertyGroup>

</Project>
